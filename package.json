{
  "name": "@refcampaign/sdk",
  "version": "2.0.0",
  "description": "Official JavaScript SDK for RefCampaign - Track affiliate conversions with ease",
  "type": "module",
  "private": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "rollup -c && rollup -c rollup.config.iife.js && node scripts/check-iife-bundle-size.mjs",
    "build:npm": "rollup -c",
    "build:cdn": "rollup -c rollup.config.iife.js && node scripts/check-iife-bundle-size.mjs",
    "dev": "rollup -c --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "type-check": "tsc --noEmit",
    "prepublishOnly": "pnpm build && pnpm test && pnpm type-check",
    "release": "npm publish --access public && git push origin sdk-v$npm_package_version"
  },
  "keywords": [
    "refcampaign",
    "affiliate",
    "tracking",
    "stripe",
    "sdk"
  ],
  "author": "RefCampaign",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/RefCampaign/sdk.git"
  },
  "homepage": "https://www.refcampaign.com",
  "bugs": {
    "url": "https://github.com/RefCampaign/sdk/issues"
  },
  "devDependencies": {
    "@rollup/plugin-node-resolve": "^15.2.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^12.1.2",
    "@types/node": "^24.9.1",
    "@vitest/coverage-v8": "^2.1.8",
    "happy-dom": "^20.0.10",
    "rollup": "^4.30.1",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  },
  "files": [
    "dist",
    "assets"
  ]
}
